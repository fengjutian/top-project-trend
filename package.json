{
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "media:import": "node scripts/media-import.mjs",
    "media:audit": "node scripts/media-audit.mjs",
    "media:audit:strict": "node scripts/media-audit.mjs --strict",
    "article:new": "node scripts/article-new.mjs",
    "article:dates": "node scripts/article-dates.mjs",
    "article:schedule": "node scripts/article-schedule.mjs",
    "links:audit": "node scripts/link-audit.mjs",
    "media:audit:build": "node scripts/media-audit.mjs --strict --write-manifest",
    "preinstall": "npx only-allow pnpm",
    "del": "rimraf node_modules",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "dependencies": {
    "@docusaurus/core": "2.0.1",
    "@docusaurus/plugin-content-blog": "2.0.1",
    "@docusaurus/plugin-pwa": "2.0.1",
    "@docusaurus/preset-classic": "2.0.1",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@mdx-js/react": "^1.6.22",
    "@react-three/fiber": "7.0.29",
    "clsx": "^1.2.1",
    "lucide-react": "^0.534.0",
    "mdx-runtime-compiler": "npm:@mdx-js/mdx@2.3.0",
    "prism-react-renderer": "^1.3.5",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-snowfall": "^2.3.0",
    "rimraf": "^6.0.1",
    "three": "0.149.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "2.0.1",
    "commitizen": "^4.3.1",
    "cz-emoji": "1.3.2-canary.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.14"
  }
