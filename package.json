{
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "media:import": "node --no-warnings --experimental-strip-types scripts/media-import.ts",
    "media:audit": "node --no-warnings --experimental-strip-types scripts/media-audit.ts",
    "media:audit:strict": "node --no-warnings --experimental-strip-types scripts/media-audit.ts --strict",
    "article:new": "node --no-warnings --experimental-strip-types scripts/article-new.ts",
    "article:dates": "node --no-warnings --experimental-strip-types scripts/article-dates.ts",
    "article:schedule": "node --no-warnings --experimental-strip-types scripts/article-schedule.ts",
    "links:audit": "node --no-warnings --experimental-strip-types scripts/link-audit.ts",
    "media:audit:build": "node --no-warnings --experimental-strip-types scripts/media-audit.ts --strict --write-manifest",
    "typecheck": "tsc --noEmit",
    "preinstall": "npx only-allow pnpm",
    "del": "rimraf node_modules",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-pwa": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.1",
    "@react-three/fiber": "8.18.0",
    "clsx": "^1.2.1",
    "lucide-react": "^0.534.0",
        "prism-react-renderer": "^2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-snowfall": "^2.4.0",
    "rimraf": "^6.1.3",
    "three": "0.149.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "~0.149.0",
    "commitizen": "^4.3.2",
    "cz-emoji": "1.3.2-canary.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
